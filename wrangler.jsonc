{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcard-db",
      "database_id": "e2742c38-4600-455d-8212-2db99b999992",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "e00fdc66534442069f9452e728ea8bbf"
    }
  ],
  // "r2_buckets": [
  //   {
  //     "binding": "BUCKET",
  //     "bucket_name": "mcard-images"
  //   }
  // ]
}
